# Built binary — `task build` / `go build -o lacre .` drops it here.
# Anchored so it can only match the artifact at the repo root.
/lacre
/lacre.exe

# Release archives — `task release:snapshot` / goreleaser write them here.
/dist/

# Go test and coverage artifacts.
*.test
*.out

# Editors and IDEs.
.idea/

# Browser automation — playwright-cli writes console logs and page snapshots here.
/.playwright-cli/

# Agent instructions and local working notes.
/.claude/
/local/

